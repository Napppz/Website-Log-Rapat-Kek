# ==========================================
# Environment Variables for Vercel Deployment
# SIM-RAPAT KEK RI
# ==========================================

# 1. Database (Neon PostgreSQL)
# Gunakan pooled connection untuk DATABASE_URL (dengan pgbouncer / -pooler)
DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-YOUR-PROJECT-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
# Gunakan direct connection untuk DIRECT_URL (tanpa pooler) untuk migrasi
DIRECT_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-YOUR-PROJECT.us-east-2.aws.neon.tech/neondb?sslmode=require"

# 2. NextAuth.js v5 Authentication
# Generate kunci rahasia baru dengan: openssl rand -base64 32
AUTH_SECRET="your-32-character-secret-key-here"
NEXTAUTH_SECRET="your-32-character-secret-key-here"

# 3. App URL (Di Vercel bisa dikosongkan atau diisi domain produksi Anda)
# NEXTAUTH_URL="https://your-domain.vercel.app"
# AUTH_URL="https://your-domain.vercel.app"
