generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  STAFF
}

enum MeetingStatus {
  DRAFT
  REVIEW
  APPROVED
  FINAL
}

enum AttendanceStatus {
  INVITED
  PRESENT
  ABSENT
  EXCUSED
}

enum ActionItemStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  OVERDUE
}

enum ActionItemPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Biro {
  id          String   @id @default(uuid()) @map("id_biro")
  code        String   @unique @map("kode_biro")
  name        String   @map("nama_biro")
  shortName   String   @map("nama_singkat")
  description String?  @map("deskripsi")
  isActive    Boolean  @default(true) @map("status_aktif")
  createdAt   DateTime @default(now()) @map("dibuat_pada")
  updatedAt   DateTime @updatedAt @map("diperbarui_pada")

  users           User[]
  primaryMeetings Meeting[]            @relation("PrimaryBiroMeetings")
  meetingBiros    MeetingBiro[]
  sequence        BiroMeetingSequence?
  actionItems     ActionItem[]         @relation("BiroActionItems")
  teams           BiroTeam[]

  @@index([code])
  @@map("biro")
}

model User {
  id        String   @id @default(uuid()) @map("id_pengguna")
  name      String   @map("nama_lengkap")
  email     String   @unique @map("email")
  password  String?  @map("kata_sandi")
  role      UserRole @default(STAFF) @map("peran")
  biroId    String   @map("id_biro")
  teamId    String?  @map("id_tim")
  isActive  Boolean  @default(true) @map("status_aktif")
  createdAt DateTime @default(now()) @map("dibuat_pada")
  updatedAt DateTime @updatedAt @map("diperbarui_pada")

  biro                Biro                 @relation(fields: [biroId], references: [id], onDelete: Restrict)
  team                BiroTeam?            @relation(fields: [teamId], references: [id], onDelete: SetNull)
  chairedMeetings     Meeting[]            @relation("ChairpersonMeetings")
  secretaryMeetings   Meeting[]            @relation("SecretaryMeetings")
  meetingParticipants MeetingParticipant[]
  actionItems         ActionItem[]         @relation("UserActionItems")
  actionItemLogs      ActionItemLog[]
  notifications       Notification[]
  minutesComments     MinutesComment[]
  minutesHistories    MinutesHistory[]

  @@index([email])
  @@index([biroId])
  @@index([teamId])
  @@index([isActive])
  @@map("pengguna")
}

model Meeting {
  id                String        @id @default(uuid()) @map("id_rapat")
  meetingNumber     String        @unique @map("nomor_rapat")
  title             String        @map("judul_rapat")
  primaryBiroId     String        @map("id_biro")
  primaryTeamId     String?       @map("id_tim")
  date              DateTime      @map("tanggal_rapat")
  startTime         String        @map("waktu_mulai")
  endTime           String        @map("waktu_selesai")
  location          String        @map("lokasi_rapat")
  chairpersonId     String?       @map("id_pengguna")
  secretaryId       String?       @map("id_notulis")
  previousMeetingId String?       @map("id_rapat_sebelumnya")
  status            MeetingStatus @default(DRAFT) @map("status_rapat")
  meetingKind         String?       @map("jenis_rapat")
  picName             String?       @map("pic_rapat")
  progressStatus      String?       @default("Start") @map("status_progres")
  invitationDocUrl    String?       @map("dokumen_undangan_url")
  invitationDocName   String?       @map("nama_dokumen_undangan")
  invitationDocSize   Int?          @map("ukuran_dokumen_undangan")
  categoryDocUrl      String?       @map("kategori_dokumen_url")
  categoryDocName     String?       @map("kategori_dokumen_nama")
  categoryDocSize     Int?          @map("kategori_dokumen_ukuran")
  materialDocUrl      String?       @map("materi_dokumen_url")
  materialDocName     String?       @map("materi_dokumen_nama")
  materialDocSize     Int?          @map("materi_dokumen_ukuran")
  documentCategory    String?       @default("UNDANGAN_INTERNAL") @map("kategori_naskah")
  documentSubCategory String?       @map("sub_kategori_naskah")
  sourceOrigin        String?       @map("asal_naskah_masuk")
  postponeReason      String?       @map("alasan_penundaan")
  createdAt           DateTime      @default(now()) @map("dibuat_pada")
  updatedAt           DateTime      @updatedAt @map("diperbarui_pada")

  primaryBiro      Biro                 @relation("PrimaryBiroMeetings", fields: [primaryBiroId], references: [id], onDelete: Restrict)
  primaryTeam      BiroTeam?            @relation("PrimaryTeamMeetings", fields: [primaryTeamId], references: [id], onDelete: SetNull)
  chairperson      User?                @relation("ChairpersonMeetings", fields: [chairpersonId], references: [id], onDelete: SetNull)
  secretary        User?                @relation("SecretaryMeetings", fields: [secretaryId], references: [id], onDelete: SetNull)
  previousMeeting  Meeting?             @relation("FollowUpMeetings", fields: [previousMeetingId], references: [id], onDelete: SetNull)
  followUpMeetings Meeting[]            @relation("FollowUpMeetings")
  meetingBiros     MeetingBiro[]
  participants     MeetingParticipant[]
  minutes          MeetingMinutes?
  actionItems      ActionItem[]
  comments         MinutesComment[]
  history          MinutesHistory[]
  attachments      MeetingAttachment[]

  @@index([meetingNumber])
  @@index([primaryBiroId])
  @@index([primaryTeamId])
  @@index([previousMeetingId])
  @@index([date])
  @@index([status])
  @@index([createdAt])
  @@map("rapat")
}

model MeetingBiro {
  meetingId String @map("id_rapat")
  biroId    String @map("id_biro")

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  biro    Biro    @relation(fields: [biroId], references: [id], onDelete: Restrict)

  @@id([meetingId, biroId])
  @@index([meetingId])
  @@index([biroId])
  @@map("rapat_biro")
}

model MeetingParticipant {
  id               String           @id @default(uuid()) @map("id_peserta")
  meetingId        String           @map("id_rapat")
  userId           String           @map("id_pengguna")
  attendanceStatus AttendanceStatus @default(INVITED) @map("status_kehadiran")
  createdAt        DateTime         @default(now()) @map("dibuat_pada")

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([meetingId, userId])
  @@index([meetingId])
  @@index([userId])
  @@map("peserta_rapat")
}

model BiroMeetingSequence {
  id            String   @id @default(uuid()) @map("id_penomoran")
  biroId        String   @unique @map("id_biro")
  currentNumber Int      @default(0) @map("nomor_terakhir")
  createdAt     DateTime @default(now()) @map("dibuat_pada")
  updatedAt     DateTime @updatedAt @map("diperbarui_pada")

  biro Biro @relation(fields: [biroId], references: [id], onDelete: Cascade)

  @@index([biroId])
  @@map("penomoran_rapat_biro")
}

model MeetingMinutes {
  id         String   @id @default(uuid()) @map("id_notulen")
  meetingId  String   @unique @map("id_rapat")
  agenda     Json?    @map("agenda_pembahasan")
  discussion Json?    @map("hasil_pembahasan")
  decisions  Json?    @map("poin_keputusan")
  conclusion Json?    @map("kesimpulan")
  createdAt  DateTime @default(now()) @map("dibuat_pada")
  updatedAt  DateTime @updatedAt @map("diperbarui_pada")

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId])
  @@map("notulen_rapat")
}

model ActionItem {
  id          String             @id @default(uuid()) @map("id_tindak_lanjut")
  meetingId   String             @map("id_rapat")
  title       String             @map("judul_tindakan")
  description String?            @map("deskripsi_tindakan")
  picBiroId   String             @map("id_biro")
  picTeamId   String?            @map("id_tim")
  picUserId   String?            @map("id_pengguna")
  dueDate     DateTime           @map("tenggat_waktu")
  status      ActionItemStatus   @default(PENDING) @map("status_tindak_lanjut")
  priority    ActionItemPriority @default(MEDIUM) @map("skala_prioritas")
  completedAt DateTime?          @map("diselesaikan_pada")
  createdAt   DateTime           @default(now()) @map("dibuat_pada")
  updatedAt   DateTime           @updatedAt @map("diperbarui_pada")

  meeting Meeting   @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  picBiro Biro      @relation("BiroActionItems", fields: [picBiroId], references: [id], onDelete: Restrict)
  picTeam BiroTeam? @relation("TeamActionItems", fields: [picTeamId], references: [id], onDelete: SetNull)
  picUser User?     @relation("UserActionItems", fields: [picUserId], references: [id], onDelete: SetNull)
  logs    ActionItemLog[]

  @@index([meetingId])
  @@index([picBiroId])
  @@index([picTeamId])
  @@index([picUserId])
  @@index([status])
  @@index([dueDate])
  @@map("tindak_lanjut")
}

model MeetingAttachment {
  id         String   @id @default(uuid()) @map("id_lampiran")
  meetingId  String   @map("id_rapat")
  fileName   String   @map("nama_berkas")
  fileUrl    String   @map("url_berkas")
  fileSize   Int?     @map("ukuran_berkas")
  fileType   String?  @map("tipe_berkas")
  uploadedBy String?  @map("nama_pengunggah")
  category   String?  @default("MATERIAL") @map("kategori")
  createdAt  DateTime @default(now()) @map("dibuat_pada")

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId])
  @@index([createdAt])
  @@map("lampiran_rapat")
}

model ActionItemLog {
  id             String            @id @default(uuid()) @map("id_riwayat")
  actionItemId   String            @map("id_tindak_lanjut")
  userId         String?           @map("id_pengguna")
  previousStatus ActionItemStatus? @map("status_sebelumnya")
  newStatus      ActionItemStatus  @map("status_terbaru")
  notes          String            @map("catatan_progres")
  progress       Int?              @default(0) @map("persentase_progres")
  createdAt      DateTime          @default(now()) @map("dibuat_pada")

  actionItem ActionItem @relation(fields: [actionItemId], references: [id], onDelete: Cascade)
  user       User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([actionItemId])
  @@index([userId])
  @@index([createdAt])
  @@map("riwayat_tindak_lanjut")
}

model Notification {
  id        String   @id @default(uuid()) @map("id_notifikasi")
  userId    String?  @map("id_pengguna")
  title     String   @map("judul")
  message   String   @map("pesan")
  type      String   @default("info") @map("tipe")
  link      String?  @map("tautan")
  isRead    Boolean  @default(false) @map("sudah_dibaca")
  createdAt DateTime @default(now()) @map("dibuat_pada")

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@map("notifikasi")
}

model MinutesComment {
  id          String              @id @default(uuid()) @map("id_komentar")
  meetingId   String              @map("id_rapat")
  userId      String?             @map("id_pengguna")
  parentId    String?             @map("id_induk")
  content     String              @map("isi_komentar")
  section     String?             @map("seksi") // e.g. 'agenda', 'discussion', 'decisions'
  isResolved  Boolean             @default(false) @map("sudah_diselesaikan")
  resolvedBy  String?             @map("diselesaikan_oleh")
  resolvedAt  DateTime?           @map("diselesaikan_pada")
  createdAt   DateTime            @default(now()) @map("dibuat_pada")
  updatedAt   DateTime            @updatedAt @map("diperbarui_pada")

  meeting  Meeting          @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user     User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  parent   MinutesComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  MinutesComment[] @relation("CommentReplies")

  @@index([meetingId])
  @@index([userId])
  @@index([parentId])
  @@index([isResolved])
  @@map("komentar_notulen")
}

model MinutesHistory {
  id          String   @id @default(uuid()) @map("id_riwayat")
  meetingId   String   @map("id_rapat")
  userId      String?  @map("id_pengguna")
  changeType  String   @map("tipe_perubahan") // e.g. 'CREATED', 'UPDATED', 'STATUS_CHANGED'
  fieldName   String?  @map("nama_kolom")
  oldValue    Json?    @map("nilai_lama")
  newValue    Json?    @map("nilai_baru")
  summary     String?  @map("ringkasan_perubahan")
  createdAt   DateTime @default(now()) @map("dibuat_pada")

  meeting  Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user     User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([meetingId])
  @@index([userId])
  @@index([createdAt])
  @@map("riwayat_notulen")
}

model BiroTeam {
  id          String   @id @default(uuid()) @map("id_tim")
  biroId      String   @map("id_biro")
  code        String   @map("kode_tim")
  name        String   @map("nama_tim")
  description String?  @map("deskripsi_tim")
  isActive    Boolean  @default(true) @map("status_aktif")
  createdAt   DateTime @default(now()) @map("dibuat_pada")
  updatedAt   DateTime @updatedAt @map("diperbarui_pada")

  biro            Biro         @relation(fields: [biroId], references: [id], onDelete: Cascade)
  primaryMeetings Meeting[]    @relation("PrimaryTeamMeetings")
  actionItems     ActionItem[] @relation("TeamActionItems")
  users           User[]

  @@unique([biroId, code])
  @@index([biroId])
  @@map("tim_biro")
}


