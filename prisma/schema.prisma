generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  NOTULIS
  STAFF
  VIEWER
}

enum MeetingStatus {
  DRAFT
  REVIEW
  APPROVED
  FINAL
}

enum AttendanceStatus {
  INVITED
  PRESENT
  ABSENT
  EXCUSED
}

enum ActionItemStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  OVERDUE
}

enum ActionItemPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Biro {
  id          String   @id @default(uuid()) @map("biro_id")
  code        String   @unique
  name        String
  shortName   String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users           User[]
  primaryMeetings Meeting[]            @relation("PrimaryBiroMeetings")
  meetingBiros    MeetingBiro[]
  sequence        BiroMeetingSequence?
  actionItems     ActionItem[]         @relation("BiroActionItems")

  @@index([code])
}

model User {
  id        String   @id @default(uuid()) @map("user_id")
  name      String
  email     String   @unique
  password  String?
  role      UserRole @default(STAFF)
  biroId    String   @map("biro_id")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  biro                Biro                 @relation(fields: [biroId], references: [id], onDelete: Restrict)
  chairedMeetings     Meeting[]            @relation("ChairpersonMeetings")
  secretaryMeetings   Meeting[]            @relation("SecretaryMeetings")
  meetingParticipants MeetingParticipant[]
  actionItems         ActionItem[]         @relation("UserActionItems")
  accounts            Account[]
  sessions            Session[]

  @@index([email])
  @@index([biroId])
  @@index([isActive])
}

model Meeting {
  id                String        @id @default(uuid()) @map("meeting_id")
  meetingNumber     String        @unique
  title             String
  primaryBiroId     String        @map("primary_biro_id")
  date              DateTime
  startTime         String
  endTime           String
  location          String
  chairpersonId     String?       @map("chairperson_id")
  secretaryId       String?       @map("secretary_id")
  previousMeetingId String?       @map("previous_meeting_id")
  status            MeetingStatus @default(DRAFT)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  primaryBiro      Biro                 @relation("PrimaryBiroMeetings", fields: [primaryBiroId], references: [id], onDelete: Restrict)
  chairperson      User?                @relation("ChairpersonMeetings", fields: [chairpersonId], references: [id], onDelete: SetNull)
  secretary        User?                @relation("SecretaryMeetings", fields: [secretaryId], references: [id], onDelete: SetNull)
  previousMeeting  Meeting?             @relation("FollowUpMeetings", fields: [previousMeetingId], references: [id], onDelete: SetNull)
  followUpMeetings Meeting[]            @relation("FollowUpMeetings")
  meetingBiros     MeetingBiro[]
  participants     MeetingParticipant[]
  minutes          MeetingMinutes?
  actionItems      ActionItem[]

  @@index([meetingNumber])
  @@index([primaryBiroId])
  @@index([previousMeetingId])
  @@index([date])
  @@index([status])
  @@index([createdAt])
}

model MeetingBiro {
  meetingId String @map("meeting_id")
  biroId    String @map("biro_id")

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  biro    Biro    @relation(fields: [biroId], references: [id], onDelete: Restrict)

  @@id([meetingId, biroId])
  @@index([meetingId])
  @@index([biroId])
}

model MeetingParticipant {
  id               String           @id @default(uuid()) @map("participant_id")
  meetingId        String           @map("meeting_id")
  userId           String           @map("user_id")
  attendanceStatus AttendanceStatus @default(INVITED)
  createdAt        DateTime         @default(now())

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([meetingId, userId])
  @@index([meetingId])
  @@index([userId])
}

model BiroMeetingSequence {
  id            String   @id @default(uuid()) @map("sequence_id")
  biroId        String   @unique @map("biro_id")
  currentNumber Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  biro Biro @relation(fields: [biroId], references: [id], onDelete: Cascade)

  @@index([biroId])
}

model MeetingMinutes {
  id         String   @id @default(uuid()) @map("minutes_id")
  meetingId  String   @unique @map("meeting_id")
  agenda     Json?
  discussion Json?
  decisions  Json?
  conclusion Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId])
}

model ActionItem {
  id          String             @id @default(uuid()) @map("action_item_id")
  meetingId   String             @map("meeting_id")
  title       String
  description String?
  picBiroId   String             @map("pic_biro_id")
  picUserId   String?            @map("pic_user_id")
  dueDate     DateTime
  status      ActionItemStatus   @default(PENDING)
  priority    ActionItemPriority @default(MEDIUM)
  completedAt DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  picBiro Biro    @relation("BiroActionItems", fields: [picBiroId], references: [id], onDelete: Restrict)
  picUser User?   @relation("UserActionItems", fields: [picUserId], references: [id], onDelete: SetNull)

  @@index([meetingId])
  @@index([picBiroId])
  @@index([picUserId])
  @@index([status])
  @@index([dueDate])
}

model Account {
  id                String  @id @default(uuid()) @map("account_id")
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(uuid()) @map("session_id")
  sessionToken String   @unique
  userId       String   @map("user_id")
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}
